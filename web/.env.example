# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# App
NEXT_PUBLIC_APP_NAME=PromptIO
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (if used directly from frontend)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature Flags
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_TEAMS=true

# External Services (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
# NEXT_PUBLIC_HOTJAR_ID=xxxxxxx
# NEXT_PUBLIC_INTERCOM_APP_ID=xxxxxxx

# OAuth Providers (if using NextAuth or similar)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# NEXT_PUBLIC_GITHUB_CLIENT_ID=xxx
# NEXT_PUBLIC_DISCORD_CLIENT_ID=xxx

# CDN / Assets
# NEXT_PUBLIC_CDN_URL=https://cdn.promptio.app

# WebSocket (if real-time features)
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws